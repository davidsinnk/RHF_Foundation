<?xml version="1.0" encoding="utf-8" ?>
<Shell
x:Class="RHF_Foundation.AppShell"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:views="clr-namespace:RHF_Foundation.Views"
Shell.NavBarIsVisible="False"
Shell.BackgroundColor="{StaticResource RicksOrange}"
Shell.ForegroundColor="White"
Shell.TabBarTitleColor="White"
Shell.TabBarUnselectedColor="#D0D4DA"
>
<!--

Tabbar-background-color="{StaticResource RicksOrange}">

-->

<!-- Landing / Home -->
