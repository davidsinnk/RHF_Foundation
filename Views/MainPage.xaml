<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RHF_Foundation.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RHF_Foundation.ViewModels">
    <!--BackgroundColor="{StaticResource PageBackground}"> -->


    <ContentPage.Padding>
        <OnPlatform x:TypeArguments="Thickness">
            <On Platform="Android" Value="0" />
            <On Platform="iOS"     Value="0" />
            <On Platform="MacCatalyst" Value="0" />
            <On Platform="WinUI"   Value="0" />
        </OnPlatform>
    </ContentPage.Padding>

    <ContentPage.Resources>
        <!-- Card look & feel -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="Grey" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#33000000" Radius="8" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="10,6" />
        </Style>

        <!-- Text styles -->
        <Style x:Key="MonthBadgeStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource RicksOrange}" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="8"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="MonthTextStyle" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="EventTitleStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="MetaStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="Grey" />
        </Style>

        <Style x:Key="LinkStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="TextColor" Value="Black" />
        </Style>
    </ContentPage.Resources>




    <ScrollView>
        <VerticalStackLayout Spacing="8" Padding="16,0,16,16">

            <!--Top Menu-->
            <StackLayout x:Name="MainTopMenu">
                <StackLayout x:Name="MainViewTopMenu" Orientation="Horizontal" VerticalOptions="Start"  Padding="0,0,0,0">
                
                    <StackLayout HorizontalOptions="StartAndExpand" Padding="5,0" Orientation="Horizontal">
                        <ImageButton Source="check_in.png"
                                     WidthRequest="{OnPlatform iOS=30, Android=40}"
                                     HorizontalOptions="Center"
                                     VerticalOptions="CenterAndExpand"
                                     Command="{Binding CheckInCommand}"
                                     Padding="5,0"/>
                        <Label Text="Sign In" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center" TextColor="{StaticResource RicksOrange}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CheckInCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" HorizontalOptions="EndAndExpand" Padding="5,0" Margin="0,0,5,0" VerticalOptions="Center">
                        <Label Text="User Name" FontSize="20" VerticalOptions="Center" HorizontalOptions="Center" TextColor="{StaticResource RicksOrange}" Padding="5,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CheckInCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Frame CornerRadius="15" HeightRequest="30" WidthRequest="30" HorizontalOptions="Center" Padding="0" HasShadow="False"
                               IsClippedToBounds="True" BackgroundColor="{StaticResource RicksOrange}">
                            <ImageButton Source="soldier.png"  HorizontalOptions="CenterAndExpand" VerticalOptions="CenterAndExpand" Command="{Binding CheckInCommand}" Aspect="Fill" />
                        </Frame>
                    </StackLayout>
                </StackLayout>
            </StackLayout>

            <Image Source="rhflogo.png" HeightRequest="130" BackgroundColor="{StaticResource RicksOrange}" HorizontalOptions="Fill" Aspect="AspectFill"  />

            <Label Style="{StaticResource H2}" Text="Reminders"/>
            <!-- FIXED LINE -->
            <Label Text="No reminders for user" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />

            <!-- Upcoming events -->
            <Label Style="{StaticResource H2}" Text="Upcoming Events"/>

            <Grid Padding="2">
                <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <!-- 3 rows: (1) Month + Title, (2) Date/Time, (3) Link -->
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*">
                                    <!-- Row 0: Month badge + Event name -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Style="{StaticResource MonthBadgeStyle}">
                                            <Label Text="{Binding MonthAbbrev}" Style="{StaticResource MonthTextStyle}" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding EventName}"
                                               Style="{StaticResource EventTitleStyle}" />
                                    </Grid>

                                    <!-- Row 1: Date and Time -->
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="12" Margin="0,6,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding EventDate}"
                                               Style="{StaticResource MetaStyle}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding TimeRange}"
                                               Style="{StaticResource MetaStyle}" />
                                    </Grid>

                                    <!-- Row 2: Clickable link -->
                                    <Label Grid.Row="2"
                                           Margin="0,8,0,0"
                                           Text="{Binding LinkText}"
                                           Style="{StaticResource LinkStyle}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenLinkCommand}"
                                                CommandParameter="{Binding LinkUrl}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
