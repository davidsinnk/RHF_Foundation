            </VerticalStackLayout>
        </Border>
            <Border Style="{StaticResource Card}" Grid.Column="0" Grid.Row="1">
            <VerticalStackLayout>
            <Label Style="{StaticResource H2}" Text="Meals"/>
            <Button Text="This Week" Command="{Binding GoMealsCommand}"/>
            </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Grid.Column="1" Grid.Row="1">
            <VerticalStackLayout>
            <Label Style="{StaticResource H2}" Text="Activities"/>
            <Button Text="Browse" Command="{Binding GoActivitiesCommand}"/>
            </VerticalStackLayout>
        </Border>
    </Grid>




