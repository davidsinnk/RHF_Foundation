<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RHF_Foundation.Views.ActivitiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RHF_Foundation.ViewModels"
    Title="Get Involved">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- Header -->
        <Label Text="ACTIVITIES"
               FontAttributes="Bold"
               FontSize="32"
               HorizontalOptions="Center"
               TextColor="{StaticResource RicksOrange}"
               Margin="0,20,0,10"/>



        <!-- Responsive Top Tabs -->
        <Grid Grid.Row="2"
              BackgroundColor="White"
              Padding="0,8"
              ColumnSpacing="20"
              HorizontalOptions="CenterAndExpand"
              MaximumWidthRequest="560"
              ColumnDefinitions="*,*">

            <!-- Events -->
            <Border Grid.Column="0"
                    HeightRequest="60"
                    MinimumWidthRequest="160"
                    Padding="14,8"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <Ellipse/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image Source="event.png" WidthRequest="22" HeightRequest="22"/>
                    <Label Text="Events"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectEventsCommand}"/>
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsEventsVisible}" Value="True">
                        <Setter Property="BackgroundColor" Value="White"/>
                        <Setter Property="Stroke" Value="{StaticResource RicksOrange}"/>
                        <Setter Property="StrokeThickness" Value="3"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsEventsVisible}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource RicksOrange}"/>
                        <Setter Property="StrokeThickness" Value="0"/>
                    </DataTrigger>
                </Border.Triggers>
            </Border>

            <!-- Programs -->
            <Border Grid.Column="1"
                    HeightRequest="60"
                    MinimumWidthRequest="160"
                    Padding="14,8"
                    HorizontalOptions="Fill"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <Ellipse/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Image Source="program.png" WidthRequest="22" HeightRequest="22"/>
                    <Label Text="Programs"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectProgramsCommand}"/>
                </Border.GestureRecognizers>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsProgramsVisible}" Value="True">
                        <Setter Property="BackgroundColor" Value="White"/>
                        <Setter Property="Stroke" Value="{StaticResource RicksOrange}"/>
                        <Setter Property="StrokeThickness" Value="3"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsProgramsVisible}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource RicksOrange}"/>
                        <Setter Property="StrokeThickness" Value="0"/>
                    </DataTrigger>
                </Border.Triggers>
            </Border>
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="3" Padding="24">
            <Grid>
                <ContentView IsVisible="{Binding IsEventsVisible}">
                    <VerticalStackLayout Spacing="20"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Image Source="event.png" WidthRequest="100" HeightRequest="100"/>
                        <Button Text="Open Events Website"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Command="{Binding OpenEventsCommand}" />
                    </VerticalStackLayout>
                </ContentView>

                <ContentView IsVisible="{Binding IsProgramsVisible}">
                    <VerticalStackLayout Spacing="20"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Image Source="program.png" WidthRequest="100" HeightRequest="100"/>
                        <Button Text="Open Programs Website"
                                FontSize="18"
                                HorizontalOptions="Center"
                                Command="{Binding OpenProgramsCommand}" />
                    </VerticalStackLayout>
                </ContentView>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
