<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RHF_Foundation.Views.Popups.CheckInPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#EE3A24"
    HorizontalOptions="Fill"
    VerticalOptions="Fill"
    Padding="-7">

    <!-- Fullscreen overlay -->
    <Grid
        BackgroundColor="#66000000"
        HorizontalOptions ="Fill"
        VerticalOptions="Fill"
        >

        <Border
            StrokeThickness="0"
            BackgroundColor="White"
            StrokeShape="RoundRectangle 16"
            Padding="20"
            WidthRequest="300"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Shadow="{OnPlatform Default}">

            <VerticalStackLayout Padding="20" Spacing="30">
                        <!-- Welcome Label -->
                        <Label Text="Welcome"
                            FontSize="36"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" 
                            TextColor="#EE3A24"/>

                        <!-- Adults Row -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Adults:" VerticalOptions="Center" FontSize="20"/>
                            <Entry x:Name="AdultsEntry"
                                WidthRequest="50"
                                Keyboard="Numeric"
                                HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>

                        <!-- Kids Row -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Kids:" VerticalOptions="Center" FontSize="20"/>
                            <Entry x:Name="KidsEntry"
                                WidthRequest="50"
                                Keyboard="Numeric"
                                HorizontalOptions="EndAndExpand" />
                        </HorizontalStackLayout>

                        <!-- Check-In Button -->
                        <Button Text="Check In"
                                BackgroundColor="#EE3A24"
                                FontSize="20"
                                TextColor="White"
                                FontAttributes="Bold"/>
                    </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>