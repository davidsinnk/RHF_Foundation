<?xml version="1.0" encoding="utf-8" ?>

<ContentPage x:Class="RHF_Foundation.Views.ProfilePage"
            xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="My Family" FontSize="24" FontAttributes="Bold"/>
        <Entry Placeholder="Family Name"/>
        <Entry Placeholder="Cabin #" Keyboard="Numeric"/>
        <Button Text="Save"/>
    </VerticalStackLayout>
</ContentPage>